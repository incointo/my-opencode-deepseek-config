{
  // No stable tag schema exists for DCP 3.1.15 (plugin ships no schema file;
  // its README points at the unpinned master URL). Removed to avoid a
  // non-reproducible $schema. Keys verified against PluginConfig in
  // dist/lib/config.d.ts of @tarquinen/opencode-dcp@3.1.15.
  "enabled": true,
  "autoUpdate": false,
  "debug": false,

  // Reduce notification noise: show compression summary only, no inline expansion
  "pruneNotification": "minimal",
  "pruneNotificationType": "toast",

  // Manual mode off: allow the model to decide when to compress (vs. waiting for /dcp command)
  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },

  // Turn protection: on (preserve N most recent turns from pruning)
  "turnProtection": {
    "enabled": true,
    "turns": 4
  },

  "commands": {
    "enabled": true
  },

  "experimental": {
    // Disable DCP for subagent sessions (short-lived; orchestrator manages upper-level context)
    "allowSubAgents": false,
    "customPrompts": false
  },

  // 受保护文件模式：不裁剪这些文件的操作
  "protectedFilePatterns": [
    "**/opencode.jsonc",
    "**/AGENTS.md",
    "**/*.env*",
    "**/.opencode/**"
  ],

  // ══════════════════════════════════════════════════════════════
  // Compression strategy — tuned for DeepSeek V4 (1M context window)
  // Core principle: proactive compression > passive overflow; DCP compresses proactively at the 77K threshold, native auto compaction is the near-overflow fallback — the two complement each other
  // 分工：内置 compaction 管自动触发 + prune（opencode.jsonc）；DCP 管主动去重 + 压缩阈值。两者互补。
  // ══════════════════════════════════════════════════════════════
  "compress": {
    // range 模式：将连续对话范围压缩为高保真摘要
    "mode": "range",
    "permission": "allow",
    "showCompression": false,
    // 摘要缓冲：压缩摘要 token 不计入 maxContextLimit，充分利用窗口
    "summaryBuffer": true,

    // 上下文阈值（绝对 token 值，不用百分比）：
    // DeepSeek V4 实际是 1M 上下文窗口（非 128K），若用百分比则 60%≈600K、
    // 30%≈300K，普通会话（20K-200K）永远达不到，DCP 永不触发压缩。
    // 改用绝对 token 值，恢复预期的 ~77K/38K 主动压缩，与模型窗口解耦。
    "maxContextLimit": 77000,
    "minContextLimit": 38000,

    // 每 3 次 LLM 请求提醒一次压缩（比默认 5 更频繁，适配 token 效率目标）
    "nudgeFrequency": 3,
    // 从用户消息后第 12 条消息开始注入压缩提醒（比默认 15 更早）
    "iterationNudgeThreshold": 12,
    // 强力推：模型被明确要求优先考虑压缩
    "nudgeForce": "strong",

    // 压缩时保留以下工具的输出（避免关键信息丢失）
    "protectedTools": [
      "task",
      "skill",
      "todowrite",
      "todoread"
    ],

    // <protect> 标签（关闭，我们暂无此使用模式）
    "protectTags": false,
    // 允许 DCP 压缩用户消息（如大型日志粘贴），关键于 DeepSeek V4 1M 窗口效率。
    // 设为 true 时会永久保留所有用户消息——20K+ 日志粘贴将不可压缩。
    "protectUserMessages": false
  },

  // 自动裁剪策略
  "strategies": {
    // 重复工具调用去重：相同 tool+args 只保留最新输出
    "deduplication": {
      "enabled": true,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    },
    // 错误工具输入裁剪：3 轮后移除错误工具调用的输入体（保留错误信息）
    "purgeErrors": {
      "enabled": true,
      "turns": 3,
      "protectedTools": [
        "task",
        "skill",
        "todowrite",
        "todoread"
      ]
    }
  }
}
